# Normalize line endings to LF so the build scripts and the pre-commit hook
# produce byte-identical output regardless of the committer's platform or
# core.autocrlf setting.
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.j2    text eol=lf
*.py    text eol=lf
*.txt   text eol=lf
*.pdf   binary

# Extensionless / dotfiles the patterns above don't catch. The hook is a shell
# script -- CRLF here would break the shebang.
.gitattributes       text eol=lf
.gitignore           text eol=lf
.githooks/pre-commit  text eol=lf
